# CourseCompass Backend Environment Variables

# Database Configuration (Neon PostgreSQL)
# Example: postgresql+psycopg2://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Security / JWT Settings
JWT_SECRET=development_super_secret_jwt_key_change_in_production_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OTP Settings
OTP_EXPIRE_MINUTES=10
ALLOWED_EMAIL_DOMAINS=iubat.edu,gmail.com

# Application Settings
APP_ENV=development
DEBUG=True
